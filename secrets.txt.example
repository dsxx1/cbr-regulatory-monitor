# ШАБЛОН. Скопируйте в secrets.txt и заполните.
#
# secrets.txt закрыт .gitignore и в репозиторий не попадёт.
# Этот файл-образец — попадёт, поэтому настоящие значения сюда не пишите.
#
# Решётка начинает комментарий. Пробелы вокруг = не важны.
# Кавычки не нужны, но если поставите — будут убраны.
#
# Всё это работает ТОЛЬКО там, где физически лежит файл.
# GitHub Actions ваш диск не видит: в облаке те же имена задаются
# через Secrets репозитория.


# ───────────────────────── Битрикс24 ─────────────────────────

# Входящий вебхук. Внутри него и номер сотрудника, и секретный токен —
# это и есть «пароль», отдельного пароля не будет.
# Где взять: Битрикс24 → Приложения → Разработчикам → Другое →
#            Входящий вебхук → права im и tasks → Сохранить.
B24_WEBHOOK = https://ваш-портал.bitrix24.ru/rest/12/xxxxxxxxxxxxxxxx/

# Выделенный чат, куда идут сводки и где бот слушает команды.
#   chat1234 — обычный чат
#   sg1234   — чат рабочей группы
#   12       — личные сообщения сотруднику
# Где взять: открыть чат в браузере и посмотреть адресную строку.
B24_CHAT_ID = chat1234

# На кого ставить задачи. Пусто — задача уйдёт на автора команды.
# Где взять: открыть профиль сотрудника, номер будет в адресе.
B24_RESPONSIBLE_ID =

# Кому разрешено командовать ботом. Номера через запятую.
# Пусто — разрешено всем участникам чата.
B24_ALLOWED_AUTHORS =

# С чего должно начинаться сообщение, чтобы стать задачей.
# Несколько вариантов через запятую. Всё остальное бот игнорирует.
B24_COMMAND_PREFIX = задача:,/задача,taskadd:


# ───────────────────────── Модель ─────────────────────────

# Ключ. Пусто — анализ выключен, обнаружение продолжает работать.
# Где взять: openrouter.ai → Keys, либо platform.deepseek.com → API keys
#
# ВАЖНО для OpenRouter: бесплатные модели по умолчанию могут использовать
# ваши запросы для обучения. Выключается в настройках приватности аккаунта:
# https://openrouter.ai/settings/privacy — сделайте это до первого запуска,
# в промпт уходит описание процессов компании.
LLM_API_KEY =

# Адрес API.
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com
LLM_BASE_URL = https://openrouter.ai/api/v1

# Модель. Рекомендуется google/gemma-4-31b-it:free — бесплатная, хорошо
# держит русский и предсказуемо отдаёт JSON. Запасной вариант, если её
# уберут: openrouter/free — автовыбор из доступных бесплатных.
#
# Бесплатные модели на OpenRouter появляются и исчезают без предупреждения,
# поэтому код терпим к ответу: если модель не умеет строгий JSON или
# обернёт его в тройные кавычки, разбор всё равно сработает.
#
# Лимиты бесплатных: 20 запросов в минуту, 50 в сутки без пополнения счёта.
# Нам хватает с запасом.
LLM_MODEL = google/gemma-4-31b-it:free

# Потолок обращений к модели за один прогон. Защита от неожиданного счёта.
LLM_MAX_CALLS_PER_RUN = 10
